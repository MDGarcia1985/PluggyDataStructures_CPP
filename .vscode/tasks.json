{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\tests\\ApplicationTests.exe",
                "${workspaceFolder}\\tests\\ApplicationTests.cpp",
                "${workspaceFolder}\\src\\Target.cpp",
                "${workspaceFolder}\\src\\TargetList.cpp",
                "${workspaceFolder}\\src\\TargetStack.cpp",
                "${workspaceFolder}\\src\\TargetQueue.cpp",
                "${workspaceFolder}\\src\\Menu.cpp",
                "${workspaceFolder}\\src\\FileLoader.cpp",
                "${workspaceFolder}\\src\\Display.cpp",
                "${workspaceFolder}\\src\\TargetProgram.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
