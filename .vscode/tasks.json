{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build application tests",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\tests\\ApplicationTests.exe",
                "${workspaceFolder}\\tests\\ApplicationTests.cpp",
                "${workspaceFolder}\\src\\app\\App.cpp",
                "${workspaceFolder}\\src\\commands\\AddTargetCommand.cpp",
                "${workspaceFolder}\\src\\commands\\DeleteTargetCommand.cpp",
                "${workspaceFolder}\\src\\commands\\DisplayListCommand.cpp",
                "${workspaceFolder}\\src\\commands\\ExitCommand.cpp",
                "${workspaceFolder}\\src\\commands\\FindTargetCommand.cpp",
                "${workspaceFolder}\\src\\commands\\MoveBackwardCommand.cpp",
                "${workspaceFolder}\\src\\commands\\MoveForwardCommand.cpp",
                "${workspaceFolder}\\src\\commands\\SortListCommand.cpp",
                "${workspaceFolder}\\src\\algorithms\\InsertionSort.cpp",
                "${workspaceFolder}\\src\\algorithms\\SelectionSort.cpp",
                "${workspaceFolder}\\src\\core\\Target.cpp",
                "${workspaceFolder}\\src\\core\\TargetList.cpp",
                "${workspaceFolder}\\src\\core\\TargetProgram.cpp",
                "${workspaceFolder}\\src\\core\\TargetQueue.cpp",
                "${workspaceFolder}\\src\\core\\TargetStack.cpp",
                "${workspaceFolder}\\src\\io\\FileLoader.cpp",
                "${workspaceFolder}\\src\\registry\\CommandRegistry.cpp",
                "${workspaceFolder}\\src\\registry\\SortRegistry.cpp",
                "${workspaceFolder}\\src\\sorting\\SortSupport.cpp",
                "${workspaceFolder}\\src\\ui\\DataSourceMenu.cpp",
                "${workspaceFolder}\\src\\ui\\Display.cpp",
                "${workspaceFolder}\\src\\ui\\MainMenu.cpp",
                "${workspaceFolder}\\src\\ui\\Menu.cpp",
                "${workspaceFolder}\\src\\ui\\SortTypeMenu.cpp",
                "${workspaceFolder}\\src\\ui\\TargetDataStructureMenu.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the complete reorganized source tree and application tests."
        }
    ],
    "version": "2.0.0"
}
